// Neon Invaders
// LEFT/RIGHT or A/D move. SPACE fires. P pauses.

PLAYER_W = 20
PLAYER_H = 15
PLAYER_Y = HEIGHT - 17

ENEMY_ROWS = 4
ENEMY_COLS = 8
ENEMY_W = 8
ENEMY_H = 6
ENEMY_SPACING_X = 13
ENEMY_SPACING_Y = 10

player = {x: WIDTH / 2, vx: 0}
playerBullets = []
enemyBullets = []
enemies = []
particles = []
stars = []
shipSheet = image("ship.png")
shipFront = resize(crop(shipSheet, 0, 0, 13, 10), 20, 15)
shipLeft = resize(crop(shipSheet, 13, 0, 13, 10), 20, 15)
shipRight = resize(crop(shipSheet, 26, 0, 13, 10), 20, 15)

enemyDir = 1
enemyTimer = 0
enemyDelay = 22
fireCooldown = 0
tick = 0
wave = 1
score = 0
lives = 3
shake = 0
paused = false
game_over = false

fun reset_game() {
  player = {x: WIDTH / 2, vx: 0}
  playerBullets = []
  enemyBullets = []
  enemies = []
  particles = []
  stars = []
  enemyDir = 1
  enemyTimer = 0
  enemyDelay = 22
  fireCooldown = 0
  tick = 0
  wave = 1
  score = 0
  lives = 3
  shake = 0
  paused = false
  game_over = false

  let i = 0
  while i < 34 {
    push(stars, {
      x: rand(0, WIDTH - 1),
      y: rand(0, HEIGHT - 1),
      layer: rand(1, 3)
    })
    i += 1
  }

  spawn_wave()
}

fun spawn_wave() {
  enemies = []
  enemyBullets = []
  playerBullets = []
  enemyDir = 1
  enemyDelay = 24 - wave * 2
  if enemyDelay < 7 enemyDelay = 7

  let row = 0
  while row < ENEMY_ROWS {
    let col = 0
    while col < ENEMY_COLS {
      push(enemies, {
        x: col * ENEMY_SPACING_X + 13,
        y: row * ENEMY_SPACING_Y + 15,
        alive: true,
        kind: row,
        phase: rand(0, 628) / 100
      })
      col += 1
    }
    row += 1
  }
}

fun clamp(v, lo, hi) {
  if v < lo {
    return lo
  }
  if v > hi {
    return hi
  }
  return v
}

fun hit_box(ax, ay, aw, ah, bx, by, bw, bh) {
  return ax < bx + bw && ax + aw > bx && ay < by + bh && ay + ah > by
}

fun add_particle(x, y, dx, dy, life, color) {
  push(particles, {x: x, y: y, dx: dx, dy: dy, life: life, color: color})
}

fun burst(x, y, color) {
  let i = 0
  while i < 14 {
    let a = rand(0, 628) / 100
    let s = rand(5, 18) / 10
    add_particle(x, y, cos(a) * s, sin(a) * s, rand(10, 24), color)
    i += 1
  }
}

fun update_particles() {
  let i = 0
  while i < len(particles) {
    particles[i].x += particles[i].dx
    particles[i].y += particles[i].dy
    particles[i].dx *= 0.96
    particles[i].dy *= 0.96
    particles[i].life -= 1
    i += 1
  }

  i = len(particles) - 1
  while i >= 0 {
    if particles[i].life <= 0 remove(particles, i)
    i -= 1
  }
}

fun alive_count() {
  let count = 0
  let i = 0
  while i < len(enemies) {
    if enemies[i].alive count += 1
    i += 1
  }
  return count
}

fun shoot_player() {
  if fireCooldown > 0 {
    return
  }
  if len(playerBullets) >= 3 {
    return
  }

  push(playerBullets, {x: player.x, y: PLAYER_Y - 4, dy: -4})
  add_particle(player.x, PLAYER_Y - 5, 0, 0 - 1.1, 8, COLOR_SOFT_IVORY)
  add_particle(player.x - 2, PLAYER_Y - 2, 0 - 0.2, 0 - 0.5, 9, COLOR_SKY_BLUE)
  add_particle(player.x + 2, PLAYER_Y - 2, 0.2, 0 - 0.5, 9, COLOR_SKY_BLUE)
  fireCooldown = 9
  play(tone(880, 45, WAVE_SINE))
}

fun shoot_enemy() {
  let live = alive_count()
  if live <= 0 {
    return
  }

  let target = rand(0, live - 1)
  let seen = 0
  let i = 0
  while i < len(enemies) {
    if enemies[i].alive {
      if seen == target {
        push(enemyBullets, {x: enemies[i].x + ENEMY_W / 2, y: enemies[i].y + ENEMY_H, dy: 2 + wave * 0.12})
        play(tone(360, 45, WAVE_SQUARE))
        return
      }
      seen += 1
    }
    i += 1
  }
}

fun move_enemies() {
  let descend = false
  let step = 1 + floor(wave / 3) * 0.4

  let i = 0
  while i < len(enemies) {
    if enemies[i].alive {
      enemies[i].x += enemyDir * step
      enemies[i].phase += 0.1
      if enemies[i].x <= 3 || enemies[i].x + ENEMY_W >= WIDTH - 3 descend = true
    }
    i += 1
  }

  if descend {
    enemyDir = -enemyDir
    i = 0
    while i < len(enemies) {
      if enemies[i].alive {
        enemies[i].y += 6
        if enemies[i].y + ENEMY_H >= PLAYER_Y {
          game_over = true
          play(tone(110, 240, WAVE_SQUARE))
        }
      }
      i += 1
    }
  }
}

fun update_play() {
  tick += 1
  if paused || game_over {
    update_particles()
    return
  }

  if shake > 0 shake -= 1
  if fireCooldown > 0 fireCooldown -= 1

  let steer = 0
  if key("KEY_LEFT") || key("KEY_A") steer -= 1
  if key("KEY_RIGHT") || key("KEY_D") steer += 1
  player.vx += steer * 0.45
  player.vx *= 0.78
  player.x += player.vx
  player.x = clamp(player.x, 10, WIDTH - 10)

  if steer != 0 && tick % 3 == 0 {
    add_particle(player.x - steer * 6, PLAYER_Y + 8, -steer * 0.4, 0.7, 10, COLOR_SKY_BLUE)
  }
  if tick % 5 == 0 add_particle(player.x + rand(-4, 4), PLAYER_Y + 7, rand(-2, 2) / 10, 0.6, 8, COLOR_AMBER_ORANGE)

  if key("KEY_SPACE") shoot_player()

  enemyTimer += 1
  if enemyTimer >= enemyDelay {
    move_enemies()
    let chance = 18 + wave * 2
    if rand(0, 100) < chance shoot_enemy()
    enemyTimer = 0
  }

  let i = 0
  while i < len(playerBullets) {
    playerBullets[i].y += playerBullets[i].dy
    i += 1
  }

  i = 0
  while i < len(enemyBullets) {
    enemyBullets[i].y += enemyBullets[i].dy
    i += 1
  }

  i = 0
  while i < len(playerBullets) {
    let bx = playerBullets[i].x
    let by = playerBullets[i].y
    let hit = false
    let e = 0
    while e < len(enemies) && !hit {
      if enemies[e].alive && hit_box(bx, by, 2, 5, enemies[e].x, enemies[e].y, ENEMY_W, ENEMY_H) {
        enemies[e].alive = false
        playerBullets[i].y = -20
        score += 10 + wave
        hit = true
        shake = 3
        burst(enemies[e].x + ENEMY_W / 2, enemies[e].y + ENEMY_H / 2, COLOR_WARM_YELLOW)
        play(tone(660, 70, WAVE_SINE))
      }
      e += 1
    }
    i += 1
  }

  i = 0
  while i < len(enemyBullets) {
    if hit_box(player.x - PLAYER_W / 2, PLAYER_Y, PLAYER_W, PLAYER_H, enemyBullets[i].x, enemyBullets[i].y, 2, 5) {
      enemyBullets[i].y = HEIGHT + 20
      lives -= 1
      shake = 12
      burst(player.x, PLAYER_Y + PLAYER_H / 2, COLOR_VIVID_RED)
      play(tone(120, 170, WAVE_SQUARE))
      if lives <= 0 game_over = true
    }
    i += 1
  }

  i = len(playerBullets) - 1
  while i >= 0 {
    if playerBullets[i].y < -8 remove(playerBullets, i)
    i -= 1
  }

  i = len(enemyBullets) - 1
  while i >= 0 {
    if enemyBullets[i].y > HEIGHT + 8 remove(enemyBullets, i)
    i -= 1
  }

  if alive_count() == 0 {
    wave += 1
    score += 50
    spawn_wave()
  }

  update_particles()
}

fun draw_background() {
  clear(COLOR_MIDNIGHT_BLUE)
  rect(0, 72, WIDTH, 56, COLOR_DEEP_BLUE, true)
  line(0, 10, WIDTH, 10, COLOR_DUSTY_PURPLE)

  let i = 0
  while i < len(stars) {
    let s = stars[i]
    let sy = (s.y + wave + tick * s.layer / 12) % HEIGHT
    let col = s.layer == 1 ? COLOR_COOL_LIGHT_GRAY : (s.layer == 2 ? COLOR_DUSTY_PURPLE : COLOR_SKY_BLUE)
    pixel(s.x, sy, col)
    if s.layer == 3 pixel(s.x + 1, sy, col)
    i += 1
  }

  let y = 24 + (tick / 3) % 16
  while y < HEIGHT {
    line(0, y, WIDTH, y, COLOR_SOFT_BLACK)
    y += 16
  }
}

fun draw_player() {
  let x = player.x
  let y = PLAYER_Y
  let flash = fireCooldown > 0 && fireCooldown % 3 != 0
  let shipSprite = shipFront
  if player.vx < 0 - 0.35 shipSprite = shipLeft
  if player.vx > 0.35 shipSprite = shipRight

  circ(x, y + 5, 12, COLOR_DEEP_BLUE)
  circ(x, y + 7, 9, flash ? COLOR_WARM_YELLOW : COLOR_SKY_BLUE)
  rend2d(shipSprite, x - 10, y)

  if fireCooldown > 0 {
    line(x, y - 2, x, y - 9, COLOR_SOFT_IVORY)
    pixel(x, y - 10, COLOR_SKY_BLUE)
  }

  let flame = 4 + sin(tick / 2) * 2
  poly([[x - 5, y + 14], [x + 5, y + 14], [x, y + 14 + flame]], COLOR_AMBER_ORANGE, true)
  line(x, y + 14, x, y + 17 + flame, COLOR_WARM_YELLOW)
}

fun draw_enemy(e) {
  if !e.alive {
    return
  }
  let x = e.x
  let y = e.y + sin(e.phase) * 1
  let color = e.kind == 0 ? COLOR_WARM_YELLOW : (e.kind == 1 ? COLOR_LIGHT_PEACH : COLOR_DUSTY_PURPLE)
  circ(x + ENEMY_W / 2, y + ENEMY_H / 2, 5, COLOR_DEEP_BLUE)
  rect(x + 1, y, ENEMY_W - 2, ENEMY_H, color, true)
  rect(x, y + 2, ENEMY_W, 3, color, true)
  pixel(x + 1, y + 1, COLOR_SOFT_IVORY)
  pixel(x + 2, y + 2, COLOR_SOFT_BLACK)
  pixel(x + ENEMY_W - 3, y + 2, COLOR_SOFT_BLACK)
  pixel(x, y + ENEMY_H, color)
  pixel(x + ENEMY_W - 1, y + ENEMY_H, color)
}

fun draw_bullets() {
  let i = 0
  while i < len(playerBullets) {
    rect(playerBullets[i].x - 1, playerBullets[i].y, 2, 6, COLOR_SOFT_IVORY, true)
    pixel(playerBullets[i].x, playerBullets[i].y - 1, COLOR_SKY_BLUE)
    pixel(playerBullets[i].x, playerBullets[i].y + 6, COLOR_DUSTY_PURPLE)
    i += 1
  }

  i = 0
  while i < len(enemyBullets) {
    circ(enemyBullets[i].x, enemyBullets[i].y + 2, 3, COLOR_ORANGE_RED)
    rect(enemyBullets[i].x - 1, enemyBullets[i].y, 2, 5, COLOR_VIVID_RED, true)
    i += 1
  }
}

fun draw_particles() {
  let i = 0
  while i < len(particles) {
    let p = particles[i]
    pixel(p.x, p.y, p.color)
    if p.life > 10 pixel(p.x + 1, p.y, p.color)
    i += 1
  }
}

fun draw_hud() {
  rect(0, 0, WIDTH, 10, COLOR_SOFT_BLACK, true)
  line(0, 10, WIDTH, 10, COLOR_SKY_BLUE)
  print("S " + score, 2, 2, COLOR_SOFT_IVORY)
  print("L " + lives, 56, 2, COLOR_LIGHT_PEACH)
  print("W " + wave, 96, 2, COLOR_SKY_BLUE)
}

fun draw_overlay(title, sub) {
  rect(14, 42, 100, 44, COLOR_SOFT_BLACK, true)
  rect(14, 42, 100, 44, COLOR_DUSTY_PURPLE)
  rect(16, 44, 96, 40, COLOR_DEEP_BLUE)
  print(title, 31, 51, COLOR_SOFT_IVORY)
  print(sub, 26, 65, COLOR_WARM_YELLOW)
  print("SPACE RESTART", 24, 77, COLOR_SKY_BLUE)
}

reset_game()

while true {
  if key("KEY_P", true) paused = !paused
  if game_over && key("KEY_SPACE") reset_game()

  update_play()

  let ox = shake > 0 ? rand(-1, 1) : 0
  let oy = shake > 0 ? rand(-1, 1) : 0
  camera(ox, oy)
  draw_background()

  let i = 0
  while i < len(enemies) {
    draw_enemy(enemies[i])
    i += 1
  }

  draw_bullets()
  draw_particles()
  draw_player()
  camera()
  draw_hud()

  if paused && !game_over draw_overlay("PAUSED", "PRESS P")
  if game_over draw_overlay("GAME OVER", "SCORE " + score)

  draw()
  sleep(16)
}
