fun binary_search(l = [], value =  0) {
    let low = 0;
    let high = #l - 1;
    while(low <= high) {
        let mid = floor((low+high) / 2);
        if(l[mid] > value) high = mid - 1;
        elif(l[mid] < value) low = mid + 1;
        else return mid;
    }
    return -1;
}

l = [1,2,3,4,5]
for i in 0..5
   println(binary_search(l, i));