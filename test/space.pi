// Star Dodger DX
// LEFT/RIGHT or A/D steer. UP boosts. Collect stars and shields, avoid red meteors.

PLAYER_W = 13
PLAYER_H = 12
STAR_R = 3
METEOR_R = 5

playerX = WIDTH / 2
playerY = HEIGHT - 18
playerVX = 0

meteors = []
gems = []
bgStars = []
particles = []

score = 0
lives = 3
shield = 0
energy = 80
tick = 0
spawn_timer = 18
gem_timer = 42
shake = 0
game_over = false

fun reset_game() {
  playerX = WIDTH / 2
  playerY = HEIGHT - 18
  playerVX = 0
  meteors = []
  gems = []
  bgStars = []
  particles = []
  score = 0
  lives = 3
  shield = 0
  energy = 80
  tick = 0
  spawn_timer = 18
  gem_timer = 42
  shake = 0
  game_over = false

  let i = 0
  while i < 42 {
    push(bgStars, {
      x: rand(0, WIDTH - 1),
      y: rand(0, HEIGHT - 1),
      layer: rand(1, 3)
    })
    i += 1
  }
}

fun clamp(v, lo, hi) {
  if v < lo return lo
  if v > hi return hi
  return v
}

fun hit_circle(ax, ay, ar, bx, by, br) {
  let dx = ax - bx
  let dy = ay - by
  let rr = ar + br
  return dx * dx + dy * dy < rr * rr
}

fun add_particle(x, y, dx, dy, life, color) {
  push(particles, {
    x: x,
    y: y,
    dx: dx,
    dy: dy,
    life: life,
    color: color
  })
}

fun burst(x, y, color) {
  let i = 0
  while i < 10 {
    let a = rand(0, 628) / 100
    let s = rand(5, 16) / 10
    add_particle(x, y, cos(a) * s, sin(a) * s, rand(10, 22), color)
    i += 1
  }
}

fun spawn_meteor() {
  let difficulty = 1 + floor(score / 180)
  let r = rand(4, 8)
  push(meteors, {
    x: rand(r, WIDTH - r),
    y: -r,
    dx: rand(-6, 6) / 10,
    dy: rand(12, 22) / 10 + difficulty * 0.08,
    r: r,
    spin: rand(-4, 4) / 100,
    angle: rand(0, 628) / 100
  })
}

fun spawn_gem() {
  let kind = rand(0, 100) < 18 ? 1 : 0
  push(gems, {
    x: rand(6, WIDTH - 6),
    y: -6,
    dy: rand(10, 17) / 10,
    kind: kind,
    phase: rand(0, 628) / 100
  })
}

fun update_particles() {
  let i = 0
  while i < len(particles) {
    particles[i].x += particles[i].dx
    particles[i].y += particles[i].dy
    particles[i].dy += 0.02
    particles[i].life -= 1
    i += 1
  }

  i = len(particles) - 1
  while i >= 0 {
    if particles[i].life <= 0 remove(particles, i)
    i -= 1
  }
}

fun update_play() {
  tick += 1
  if shake > 0 shake -= 1
  if shield > 0 shield -= 1

  let thrusting = key("KEY_UP") && energy > 0
  let steer = 0
  if key("KEY_LEFT") || key("KEY_A") steer -= 1
  if key("KEY_RIGHT") || key("KEY_D") steer += 1

  playerVX += steer * (thrusting ? 0.45 : 0.32)
  playerVX *= 0.86
  playerX += playerVX
  playerX = clamp(playerX, 8, WIDTH - 8)

  if thrusting {
    energy -= 0.55
    add_particle(playerX + rand(-4, 4), playerY + 8, rand(-3, 3) / 10, 1.3, 10, COLOR_SKY_BLUE)
  } else {
    energy += 0.12
  }
  energy = clamp(energy, 0, 100)

  add_particle(playerX + rand(-3, 3), playerY + 8, rand(-2, 2) / 10, 0.9, 8, COLOR_AMBER_ORANGE)

  spawn_timer -= 1
  gem_timer -= 1
  if spawn_timer <= 0 {
    spawn_meteor()
    spawn_timer = 20 - floor(score / 160)
    if spawn_timer < 7 spawn_timer = 7
  }
  if gem_timer <= 0 {
    spawn_gem()
    gem_timer = rand(32, 54)
  }

  let i = 0
  while i < len(meteors) {
    meteors[i].x += meteors[i].dx
    meteors[i].y += meteors[i].dy
    meteors[i].angle += meteors[i].spin

    if meteors[i].x < meteors[i].r || meteors[i].x > WIDTH - meteors[i].r meteors[i].dx *= -1

    if hit_circle(playerX, playerY, 6, meteors[i].x, meteors[i].y, meteors[i].r) {
      burst(meteors[i].x, meteors[i].y, COLOR_VIVID_RED)
      meteors[i].y = HEIGHT + 20
      shake = 12
      if shield > 0 {
        shield = 0
        score += 15
        play(tone(360, 80, WAVE_TRIANGLE))
      } else {
        lives -= 1
        play(tone(120, 150, WAVE_SQUARE))
        if lives <= 0 game_over = true
      }
    }
    i += 1
  }

  i = 0
  while i < len(gems) {
    gems[i].y += gems[i].dy
    gems[i].phase += 0.12
    let gx = gems[i].x + sin(gems[i].phase) * 2

    if hit_circle(playerX, playerY, 6, gx, gems[i].y, 5) {
      if gems[i].kind == 0 {
        score += 25
        energy += 10
        burst(gx, gems[i].y, COLOR_WARM_YELLOW)
        play(tone(760, 60, WAVE_SINE))
      } else {
        shield = 260
        score += 40
        burst(gx, gems[i].y, COLOR_SKY_BLUE)
        play(tone(520, 90, WAVE_TRIANGLE))
      }
      gems[i].y = HEIGHT + 20
    }
    i += 1
  }

  i = len(meteors) - 1
  while i >= 0 {
    if meteors[i].y > HEIGHT + 16 {
      remove(meteors, i)
      score += 1
    }
    i -= 1
  }

  i = len(gems) - 1
  while i >= 0 {
    if gems[i].y > HEIGHT + 12 remove(gems, i)
    i -= 1
  }

  update_particles()
}

fun draw_background() {
  clear(COLOR_MIDNIGHT_BLUE)
  rect(0, 72, WIDTH, 56, COLOR_DEEP_BLUE, true)

  let i = 0
  while i < len(bgStars) {
    let s = bgStars[i]
    let sy = (s.y + tick * s.layer / 4) % HEIGHT
    let col = s.layer == 1 ? COLOR_COOL_LIGHT_GRAY : COLOR_SKY_BLUE
    pixel(s.x, sy, col)
    if s.layer == 3 pixel(s.x + 1, sy, col)
    i += 1
  }
}

fun draw_ship() {
  let lean = clamp(playerVX * 1.5, -5, 5)
  let x = playerX
  let y = playerY
  let angle = lean * 0.09

  let ca = cos(angle)
  let sa = sin(angle)

  // Rotate all 3 vertices around center
  let t1x = x + 10 * sa            // tip    (0, -10)
  let t1y = y - 10 * ca
  let t2x = x - 6 * ca - 7 * sa    // rear left  (-6, 7)
  let t2y = y - 6 * sa + 7 * ca
  let t3x = x + 6 * ca - 7 * sa    // rear right (6, 7)
  let t3y = y + 6 * sa + 7 * ca

  // Rear center + exhaust direction (rotates with ship)
  let bx = (t2x + t3x) / 2
  let by = (t2y + t3y) / 2
  let fdx = -sa
  let fdy = ca

  // Shield
  if shield > 0 {
    circ(x, y, 12, shield % 12 < 6 ? COLOR_SKY_BLUE : COLOR_DUSTY_PURPLE)
    circ(x, y, 14, COLOR_COOL_LIGHT_GRAY)
  }

  // Motion trail ghosts (offset opposite to lean)
  if lean > 1 || lean < -1 {
    poly(
      [[t1x - lean * 1.5, t1y], [t2x - lean * 1.5, t2y], [t3x - lean * 1.5, t3y]],
      COLOR_DEEP_BLUE, true
    )
    poly(
      [[t1x - lean * 0.7, t1y], [t2x - lean * 0.7, t2y], [t3x - lean * 0.7, t3y]],
      COLOR_DUSTY_PURPLE, true
    )
  }

  // Main triangle (solid, rigid)
  poly([[t1x, t1y], [t2x, t2y], [t3x, t3y]], COLOR_BRIGHT_COBALT, true)

  // Edge glow
  line(t1x, t1y, t2x, t2y, COLOR_SKY_BLUE)
  line(t1x, t1y, t3x, t3y, COLOR_SKY_BLUE)
  line(t2x, t2y, t3x, t3y, COLOR_SKY_BLUE)

  // Nose pixel
  pixel(t1x, t1y, COLOR_SOFT_IVORY)

  // Thruster (direction follows ship rotation)
  if key("KEY_UP") && energy > 0 {
    poly(
      [[t2x, t2y], [t3x, t3y], [bx + fdx * 11, by + fdy * 11]],
      COLOR_AMBER_ORANGE, true
    )
    line(bx, by, bx + fdx * 14, by + fdy * 14, COLOR_WARM_YELLOW)
    line(t2x, t2y, t2x + fdx * 7, t2y + fdy * 7, COLOR_ORANGE_RED)
    line(t3x, t3y, t3x + fdx * 7, t3y + fdy * 7, COLOR_ORANGE_RED)
  }
}

fun draw_meteor(m) {
  let r = m.r
  let x = m.x
  let y = m.y
  circ(x, y, r, COLOR_BRICK_RED, true)
  circ(x, y, r - 1, COLOR_VIVID_RED, true)
  circ(x - r / 3, y - r / 3, r / 3, COLOR_ORANGE_RED, true)
  pixel(x + cos(m.angle) * r / 2, y + sin(m.angle) * r / 2, COLOR_LIGHT_PEACH)
}

fun draw_gem(g) {
  let x = g.x + sin(g.phase) * 2
  let y = g.y
  if g.kind == 0 {
    circ(x, y, STAR_R + 1, COLOR_WARM_YELLOW, true)
    circ(x, y, STAR_R - 1, COLOR_AMBER_ORANGE, true)
    pixel(x - 1, y - 2, COLOR_SOFT_IVORY)
  } else {
    poly([[x, y - 5], [x + 5, y], [x, y + 5], [x - 5, y]], COLOR_SKY_BLUE, true)
    poly([[x, y - 3], [x + 3, y], [x, y + 3], [x - 3, y]], COLOR_SOFT_IVORY)
  }
}

fun draw_particles() {
  let i = 0
  while i < len(particles) {
    pixel(particles[i].x, particles[i].y, particles[i].color)
    i += 1
  }
}

fun draw_hud() {
  rect(0, 0, WIDTH, 11, COLOR_SOFT_BLACK, true)
  print("S " + score, 2, 2, COLOR_SOFT_IVORY)
  print("L " + lives, 52, 2, COLOR_LIGHT_PEACH)
  rect(84, 3, 40, 4, COLOR_CHARCOAL_GRAY, true)
  rect(84, 3, energy * 40 / 100, 4, energy > 22 ? COLOR_SKY_BLUE : COLOR_VIVID_RED, true)
  if shield > 0 print("SH", 66, 2, COLOR_SKY_BLUE)
}

fun draw_game_over() {
  rect(14, 42, 100, 44, COLOR_SOFT_BLACK, true)
  rect(14, 42, 100, 44, COLOR_DUSTY_PURPLE)
  print("GAME OVER", 36, 51, COLOR_VIVID_RED)
  print("SCORE " + score, 36, 64, COLOR_WARM_YELLOW)
  print("SPACE RESTART", 24, 78, COLOR_SOFT_IVORY)
}

reset_game()

while true {
  if !game_over {
    update_play()
  } else {
    update_particles()
    if key("KEY_SPACE") {
      reset_game()
      while key("KEY_SPACE") sleep(20)
    }
  }

  let ox = shake > 0 ? rand(-1, 1) : 0
  let oy = shake > 0 ? rand(-1, 1) : 0
  camera(ox, oy)
  draw_background()

  let i = 0
  while i < len(gems) {
    draw_gem(gems[i])
    i += 1
  }

  i = 0
  while i < len(meteors) {
    draw_meteor(meteors[i])
    i += 1
  }

  draw_particles()
  draw_ship()
  camera()
  draw_hud()
  if game_over draw_game_over()

  draw()
  sleep(16)
}
