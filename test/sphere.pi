SPHERE_COLORS = [COLOR_WARM_BROWN, COLOR_CHARCOAL_GRAY,
                 COLOR_COOL_LIGHT_GRAY, COLOR_SOFT_IVORY,
                 COLOR_VIVID_RED, COLOR_AMBER_ORANGE,
                 COLOR_WARM_YELLOW, COLOR_SKY_BLUE]

start = time()
fun log2(x) {
 return log(x)/log(2)
}

fun smin(a,b,k) {
 let res=2^(-k*a)+2^(-k*b)
 return -log2(res)/k
}

fun dist(x,y,z) {
 return sqrt(x**2+y**2+z**2)-2
}

fun render(px, py) {
    let dx=(px-64)/40
    let dy=(py-64)/40
    let dz=1
    let t=0
    for(i in 0..10) {        
        t = t + dist(dx*t, dy*t,-3+dz*t)
        if (t < 0.0001 || t > 50) 
            break
    }    
    let hx=dx*t
    let hy=dy*t
    let hz=-3+dz*t
    if(t<5) {
        let shade = floor(abs(4 + 5 * (hx + (time() - start) / 2000)))
        return SPHERE_COLORS[shade % len(SPHERE_COLORS)]
    }
    else
        return COLOR_SOFT_BLACK
}

while(true) {    
  clear(COLOR_SOFT_BLACK)
  for(x in 0..128)
    for(y in 0..128)         
        pixel(x,y,render(x,y))
    

  draw()  
}
