

fun isPrime(num = 0) {
    if (num <= 1) return false;
    if (num <= 3) return true;
    if (num % 2 == 0 || num % 3 == 0) return false;
    for (i in 5..num:2)
        if (num % i == 0) return false;
    return true;
}

let _sum = 0;

for(i in 1..1000){
    if(isPrime(i))
        _sum += i;
}


println("Sum of primes up to 1000: " + _sum);
draw()



