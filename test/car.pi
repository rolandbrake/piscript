// Lane Runner
// LEFT/RIGHT to change lanes. Collect coins, avoid hazards.

LANES = [32, 64, 96]
CAR_W = 14
CAR_H = 18
ITEM_SIZE = 10

car_lane = 1
car_y = HEIGHT - 24

items = []
score = 30
coins = 0
tick = 0
road_scroll = 0
speed = 1
spawn_delay = 34
game_over = false

fun reset_game() {
  car_lane = 1
  items = []
  score = 30
  coins = 0
  tick = 0
  road_scroll = 0
  speed = 1
  spawn_delay = 34
  game_over = false
}

fun car_x() {
  return LANES[car_lane] - CAR_W / 2
}

fun hit_box(ax, ay, aw, ah, bx, by, bw, bh) {
  return ax < bx + bw && ax + aw > bx && ay < by + bh && ay + ah > by
}

fun spawn_item() {
  let kind = rand(0, 100) < 62 ? 0 : 1
  let item = {
    lane: rand(0, 2),
    y: -ITEM_SIZE,
    kind: kind
  }
  push(items, item)
}

fun draw_road() {
  clear(COLOR_DEEP_GREEN)
  rect(18, 0, 92, HEIGHT, COLOR_SOFT_BLACK, true)
  rect(18, 0, 2, HEIGHT, COLOR_COOL_LIGHT_GRAY, true)
  rect(108, 0, 2, HEIGHT, COLOR_COOL_LIGHT_GRAY, true)

  for y in -16..HEIGHT:24 {
    let dash_y = (y + road_scroll) % HEIGHT
    rect(48, dash_y, 3, 12, COLOR_SOFT_IVORY, true)
    rect(78, dash_y, 3, 12, COLOR_SOFT_IVORY, true)
  }
}

fun draw_car() {
  let x = car_x()
  rect(x + 2, car_y, CAR_W - 4, CAR_H, COLOR_SKY_BLUE, true)
  rect(x, car_y + 5, CAR_W, 10, COLOR_SKY_BLUE, true)
  rect(x + 3, car_y + 3, 3, 4, COLOR_SOFT_IVORY, true)
  rect(x + 8, car_y + 3, 3, 4, COLOR_SOFT_IVORY, true)
  rect(x + 1, car_y + 15, 4, 3, COLOR_SOFT_BLACK, true)
  rect(x + 9, car_y + 15, 4, 3, COLOR_SOFT_BLACK, true)
}

fun draw_coin(x, y) {
  circ(x + ITEM_SIZE / 2, y + ITEM_SIZE / 2, 5, COLOR_WARM_YELLOW, true)
  circ(x + ITEM_SIZE / 2, y + ITEM_SIZE / 2, 2, COLOR_AMBER_ORANGE, true)
}

fun draw_hazard(x, y) {
  rect(x, y, ITEM_SIZE, ITEM_SIZE, COLOR_VIVID_RED, true)
  rect(x + 2, y + 2, ITEM_SIZE - 4, ITEM_SIZE - 4, COLOR_DARK_MAGENTA, true)
}

fun draw_hud() {
  print("SCORE " + score, 2, 2, COLOR_SOFT_IVORY)
  print("COINS " + coins, 70, 2, COLOR_WARM_YELLOW)
  print("SPD " + speed, 44, 12, COLOR_COOL_LIGHT_GRAY)
}

fun draw_game_over() {
  rect(12, 40, 104, 48, COLOR_SOFT_BLACK, true)
  rect(14, 42, 100, 44, COLOR_DARK_MAGENTA, true)
  print("YOU LOST", 38, 50, COLOR_VIVID_RED)
  print("COINS " + coins, 40, 64, COLOR_WARM_YELLOW)
  print("SPACE RESTART", 24, 78, COLOR_SOFT_IVORY)
}

reset_game()

while true {
  if (!game_over) {
    tick += 1
    speed = 1 + floor(tick / 360)
    if speed > 7 {
      speed = 7
    }

    spawn_delay = 34 - speed * 3
    if spawn_delay < 12 {
      spawn_delay = 12
    }

    road_scroll = (road_scroll + speed * 2) % HEIGHT

    if key("KEY_LEFT", true) && car_lane > 0 {
      car_lane -= 1
    }
    if key("KEY_RIGHT", true) && car_lane < 2 {
      car_lane += 1
    }

    if tick % spawn_delay == 0 {
      spawn_item()
    }

    for i in 0..len(items) {
      items[i].y += speed + 1

      let item_x = LANES[items[i].lane] - ITEM_SIZE / 2
      if hit_box(car_x(), car_y, CAR_W, CAR_H, item_x, items[i].y, ITEM_SIZE, ITEM_SIZE) {
        if items[i].kind == 0 {
          score += 5
          coins += 1
          play(tone(760, 60, 0))
        } else {
          score -= 15
          play(tone(130, 140, 1))
          if score <= 0 {
            game_over = true
          }
        }
        items[i].y = HEIGHT + ITEM_SIZE
      }
    }

    let i = len(items) - 1
    while i >= 0 {
      if items[i].y > HEIGHT {
        remove(items, i)
      }
      i -= 1
    }
  } else {
    if key("KEY_SPACE") {
      reset_game()
      while key("KEY_SPACE") {
        sleep(20)
      }
    }
  }

  draw_road()

  for i in 0..len(items) {
    let x = LANES[items[i].lane] - ITEM_SIZE / 2
    if items[i].kind == 0 {
      draw_coin(x, items[i].y)
    } else {
      draw_hazard(x, items[i].y)
    }
  }

  draw_car()
  draw_hud()

  if game_over {
    draw_game_over()
  }

  draw()
  sleep(30)
}
