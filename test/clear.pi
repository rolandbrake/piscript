PALETTE = [COLOR_SOFT_BLACK, COLOR_DEEP_BLUE, COLOR_DARK_MAGENTA,
           COLOR_DEEP_GREEN, COLOR_WARM_BROWN, COLOR_CHARCOAL_GRAY,
           COLOR_COOL_LIGHT_GRAY, COLOR_SOFT_IVORY, COLOR_VIVID_RED,
           COLOR_AMBER_ORANGE, COLOR_WARM_YELLOW, COLOR_NEON_GREEN,
           COLOR_SKY_BLUE, COLOR_DUSTY_PURPLE, COLOR_PINK_ROSE,
           COLOR_LIGHT_PEACH]

i = 0
while (i < 100000) {
  clear(PALETTE[floor(rand() * len(PALETTE))])
  draw()
  sleep(100)
  i += 1
}
